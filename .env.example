CENSUS_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional OpenAI-compatible Nemotron /v1 base URL and model.
NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=
# Direct Postgres connection string used by the simulation engine.
#
# IMPORTANT: this must be a direct Postgres connection (the engine issues raw
# SQL in a single transaction per turn), NOT the Supabase PostgREST/anon URL —
# PostgREST cannot span a multi-table transaction.
#
# Local Postgres:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
#
# Supabase: Project Settings > Database > Connection string > URI
# (either the direct connection or the "Session" pooler connection works)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
