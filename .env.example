CENSUS_API_KEY=
ANTHROPIC_API_KEY=
# NVIDIA-hosted Nemotron API key (server-side only).
NVIDIA_API_KEY=
# Server-side Nemotron model for city briefings and resident dialogue.
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Google-hosted Gemini API key (server-side only). Gemini transcribes Nemotron's
# analysis records (summary, resident stances, conversation, today's event) into
# the Mayor's spoken end-of-day address; ElevenLabs then voices that text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Direct Postgres connection string used by the simulation engine.
#
# IMPORTANT: this must be a direct Postgres connection (the engine issues raw
# SQL in a single transaction per turn), NOT the Supabase PostgREST/anon URL —
# PostgREST cannot span a multi-table transaction.
#
# Local Postgres:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
#
# Supabase: Project Settings > Database > Connection string > URI
# (either the direct connection or the "Session" pooler connection works)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

ELEVENLABS_MAYOR_VOICE_ID=

ELEVENLABS_ASSISTANT_VOICE_ID=

ELEVENLABS_NEWS_VOICE_ID=
